{
  "name": "gatewright",
  "private": true,
  "version": "0.1.0",
  "description": "A 2D side-view colony-survival sandbox for the browser: dig, build, craft and defend with a small band of dwarves.",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "playwright test",
    "check": "npm run build && npm test && npm run smoke"
  },
  "dependencies": {
    "phaser": "^4.2.1",
    "preact": "^10.28.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "typescript": "^7.0.0",
    "vite": "^8.0.0",
    "vitest": "^4.1.0"
  }
}
